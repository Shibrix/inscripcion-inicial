            <Label fx:id="mostrarResumen" text="Label" visible="false" GridPane.columnSpan="2" GridPane.rowIndex="10" />
            <HBox alignment="TOP_RIGHT" prefHeight="100.0" prefWidth="200.0" spacing="20.0" GridPane.columnIndex="1" GridPane.rowIndex="11">
               <children>
                  <Button fx:id="botonResumen" mnemonicParsing="false" onAction="#resumen" text="Mostrar resumen" />
                  <Button fx:id="botonVolver" onAction="#volver" mnemonicParsing="false" text="Volver" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets left="20.0" right="20.0" />
         </padding>
      </GridPane>
