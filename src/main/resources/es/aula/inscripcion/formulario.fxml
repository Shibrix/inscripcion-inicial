<BorderPane stylesheets="@formulario.css" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="es.aula.inscripcion.FormularioController">
   <top>
      <Label text="Formulario de inscripción" BorderPane.alignment="CENTER">
         <font>
            <Font size="29.0" />
         </font>
         <padding>
            <Insets bottom="30.0" />
         </padding>
      </Label>
   </top>
   <padding>
      <Insets bottom="30.0" left="20.0" right="20.0" top="15.0" />
   </padding>
   <center>
      <GridPane hgap="10.0" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" vgap="15.0" BorderPane.alignment="TOP_LEFT">
        <columnConstraints>
          <ColumnConstraints halignment="LEFT" hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Nombre y apellidos">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label text="Edad" GridPane.rowIndex="1">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label text="Teléfono" GridPane.rowIndex="2">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <TextField fx:id="nombre" GridPane.columnIndex="1" />
            <TextField fx:id="edad" maxWidth="50.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="telefono" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Email" GridPane.rowIndex="3">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <Label text="Cursos disponibles" GridPane.rowIndex="4">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <TextField fx:id="email" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <ComboBox fx:id="combo" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
            	<items>
            		<FXCollections fx:factory="observableArrayList">
            			<String fx:value="Curso de iniciación infantil" />
            			<String fx:value="Curso de iniciación adulto" />
            			<String fx:value="Curso de intermedio infantil" />
            			<String fx:value="Curso de intermedio adulto" />
            			<String fx:value="Curso de avanzado infantil" />
            			<String fx:value="Curso de avanzado adulto" />
            		</FXCollections>
            	</items>
            </ComboBox>
            <Label text="Fecha realización " GridPane.rowIndex="5">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <DatePicker fx:id="fecha" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <Label text="Observaciones" GridPane.rowIndex="6">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <TextArea fx:id="observaciones" maxHeight="120.0" prefHeight="300.0" prefWidth="100.0" GridPane.columnSpan="2" GridPane.rowIndex="7" GridPane.rowSpan="2" />
